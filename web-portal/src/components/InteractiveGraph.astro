---
export interface Props {
  url: string;
}

const { url } = Astro.props;

// Convert standard Desmos calculator edit URL to embed URL
let embedUrl = url;
if (url.includes('desmos.com/calculator') && !url.includes('embed')) {
  embedUrl = url + (url.includes('?') ? '&embed' : '?embed');
}
---

<!-- Mobile view: inline embedded iframe -->
<div class="lg:hidden my-6 border border-mathBorder rounded-xl overflow-hidden shadow-sm bg-mathBgSecondary">
  <div class="bg-mathBgSecondary py-2.5 px-4 border-b border-mathBorder flex items-center justify-between text-xs font-semibold text-mathTextMuted">
    <span>📊 Interactive Desmos Graph</span>
    <a href={url} target="_blank" class="text-accent hover:underline flex items-center gap-1">
      Open in Desmos ↗
    </a>
  </div>
  <div class="relative w-full aspect-video min-h-[280px]">
    <iframe
      src={embedUrl}
      class="absolute top-0 left-0 w-full h-full border-0"
      allowfullscreen
      allow="clipboard-write"
    ></iframe>
  </div>
</div>

<!-- Desktop view: Launch button to load inside persistent side-drawer -->
<div class="hidden lg:flex my-6 p-5 border border-mathBorder rounded-xl bg-mathBgSecondary items-center justify-between gap-4 shadow-sm select-none">
  <div class="flex items-center gap-3">
    <div class="p-3 rounded-lg bg-sky-100 dark:bg-sky-950/40 text-sky-600 dark:text-sky-400 text-2xl">
      📊
    </div>
    <div>
      <h4 class="font-bold text-mathTextNormal text-sm">Interactive Graph Simulator Available</h4>
      <p class="text-xs text-mathTextMuted mt-0.5">Explore vectors, limits, or function shifts dynamically side-by-side.</p>
    </div>
  </div>
  <button 
    class="open-desmos-drawer-btn px-4 py-2 bg-sky-500 hover:bg-sky-600 text-white rounded-lg text-sm font-bold shadow-sm transition-all flex items-center gap-1.5 active:scale-95"
    data-url={embedUrl}
  >
    Launch Grapher ↗
  </button>
</div>
