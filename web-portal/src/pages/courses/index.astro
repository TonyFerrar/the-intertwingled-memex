---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getOERPortalHome, getCourseIndex } from '../../utils/vaultLoader.js';

const oerHome = getOERPortalHome();

// Resolve course indices
const courseIds = ['calc-1', 'calc-2', 'calc-3'];
const courses = courseIds.map(id => {
  const idx = getCourseIndex(id);
  
  // Static icon/code mappings for visual continuity
  const meta: Record<string, { code: string; icon: string }> = {
    'calc-1': { code: 'MATH-181', icon: '📐' },
    'calc-2': { code: 'MATH-182', icon: '🌀' },
    'calc-3': { code: 'MATH-281', icon: '🕸️' },
  };
  
  return {
    id,
    title: idx ? idx.title : id.toUpperCase(),
    desc: idx ? idx.description : 'Curriculum details and session mapping.',
    code: meta[id]?.code || '',
    icon: meta[id]?.icon || '📐'
  };
});

const base = import.meta.env.BASE_URL;
const link = (p: string) => `${base.endsWith('/') ? base : base + '/'}${p.startsWith('/') ? p.slice(1) : p}`;
---

<BaseLayout title={oerHome.title}>
  <div class="space-y-8 max-w-5xl mx-auto">
    <!-- Hero Block -->
    <section class="py-8 px-6 bg-gradient-to-r from-blue-500 to-indigo-600 rounded-2xl text-white shadow-md">
      <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight">{oerHome.title}</h1>
      <div class="text-lg text-blue-100 mt-2 max-w-xl leading-relaxed">
        <Fragment set:html={oerHome.overviewHtml} />
      </div>
      <div class="mt-6 flex flex-wrap gap-4 select-none">
        <a href={link('/garden/limits')} class="px-4 py-2 bg-white text-blue-600 font-bold rounded-lg shadow hover:bg-blue-50 transition-colors text-sm no-underline hover:no-underline">
          🌲 Browse Digital Garden
        </a>
      </div>
    </section>

    <!-- Course Cards Grid -->
    <section class="grid md:grid-cols-3 gap-6">
      {courses.map(course => (
        <a href={link(`/courses/${course.id}`)} class="group border border-mathBorder rounded-xl p-6 bg-mathBgSecondary/30 hover:bg-mathBgSecondary/70 hover:border-accent hover:shadow transition-all duration-200 no-underline hover:no-underline flex flex-col justify-between h-full">
          <div>
            <span class="text-4xl block mb-4 select-none">{course.icon}</span>
            <h2 class="text-xl font-bold text-mathTextNormal group-hover:text-accent transition-colors flex items-center gap-2">
              {course.title}
              {course.code && (
                <span class="text-xs py-0.5 px-2 bg-mathBorder rounded font-mono text-mathTextMuted select-none">
                  {course.code}
                </span>
              )}
            </h2>
            <p class="text-sm text-mathTextMuted mt-2 leading-relaxed">
              {course.desc}
            </p>
          </div>
          <span class="text-xs font-bold text-accent group-hover:underline mt-6 block select-none">
            Explore Sessions ➜
          </span>
        </a>
      ))}
    </section>

    <!-- Project Goals / About -->
    {oerHome.aboutHtml && (
      <section class="p-6 border border-mathBorder rounded-xl bg-mathBgSecondary/40 leading-relaxed">
        <h3 class="font-bold text-lg text-mathTextNormal mb-3">About this Curriculum</h3>
        <div class="prose text-sm text-mathTextMuted max-w-none">
          <Fragment set:html={oerHome.aboutHtml} />
        </div>
      </section>
    )}
  </div>
</BaseLayout>
