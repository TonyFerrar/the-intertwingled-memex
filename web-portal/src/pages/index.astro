---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getVaultHome, getRecentlyUpdatedNotes, getOERPortalHome, getCourseIndex } from '../utils/vaultLoader.js';

const vaultHome = getVaultHome();
const recentNotes = getRecentlyUpdatedNotes();
const oerHome = getOERPortalHome();

// Resolve course indices for embedded OER portal section
const courseIds = ['calc-1', 'calc-2', 'calc-3'];
const oerCourses = courseIds.map(id => {
  const idx = getCourseIndex(id);
  const meta: Record<string, { code: string; icon: string }> = {
    'calc-1': { code: 'MATH-181', icon: '📐' },
    'calc-2': { code: 'MATH-182', icon: '🌀' },
    'calc-3': { code: 'MATH-281', icon: '🕸️' },
  };
  return {
    id,
    title: idx ? idx.title : id.toUpperCase(),
    desc: idx ? idx.description : 'Curriculum details and session mapping.',
    code: meta[id]?.code || '',
    icon: meta[id]?.icon || '📐'
  };
});

const base = import.meta.env.BASE_URL;
const link = (p: string) => `${base.endsWith('/') ? base : base + '/'}${p.startsWith('/') ? p.slice(1) : p}`;

// Type mapping helper for badges
const typeLabels: Record<string, { label: string; badge: string }> = {
  'course-session': { label: 'Session Note', badge: 'bg-accent/10 text-accent border-accent/20' },
  'concept': { label: 'Concept Card', badge: 'bg-amber-500/10 text-amber-500 border-amber-500/20' },
  'blog': { label: 'Blog Post', badge: 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20' }
};
---

<BaseLayout title={vaultHome.title}>
  <div class="space-y-8 max-w-6xl mx-auto">
    
    <!-- Full-Width Hero Section with Obsidian Graph View Background -->
    <section class="relative py-12 px-8 overflow-hidden border border-mathBorder/60 rounded-2xl shadow-xl bg-slate-950">
      <!-- Dark Glowing Network Graph SVG Background -->
      <svg class="absolute inset-0 w-full h-full select-none pointer-events-none opacity-40" xmlns="http://www.w3.org/2000/svg">
        <!-- Connections -->
        <line x1="8%" y1="20%" x2="28%" y2="35%" stroke="rgba(99, 102, 241, 0.15)" stroke-width="1" />
        <line x1="28%" y1="35%" x2="22%" y2="75%" stroke="rgba(99, 102, 241, 0.12)" stroke-width="1" />
        <line x1="28%" y1="35%" x2="52%" y2="25%" stroke="rgba(99, 102, 241, 0.2)" stroke-width="1.5" />
        <line x1="52%" y1="25%" x2="68%" y2="55%" stroke="rgba(99, 102, 241, 0.15)" stroke-width="1" />
        <line x1="52%" y1="25%" x2="48%" y2="85%" stroke="rgba(99, 102, 241, 0.1)" stroke-width="1" />
        <line x1="68%" y1="55%" x2="88%" y2="25%" stroke="rgba(99, 102, 241, 0.18)" stroke-width="1.2" />
        <line x1="68%" y1="55%" x2="78%" y2="80%" stroke="rgba(99, 102, 241, 0.12)" stroke-width="1" />
        <line x1="22%" y1="75%" x2="48%" y2="85%" stroke="rgba(99, 102, 241, 0.08)" stroke-width="1" />
        
        <!-- Nodes -->
        <circle cx="8%" cy="20%" r="3.5" fill="rgba(129, 140, 248, 0.4)" />
        <circle cx="28%" cy="35%" r="5.5" fill="rgba(99, 102, 241, 0.65)" />
        <circle cx="22%" cy="75%" r="4.5" fill="rgba(129, 140, 248, 0.45)" />
        <circle cx="52%" cy="25%" r="6.5" fill="rgba(99, 102, 241, 0.75)" />
        <circle cx="48%" cy="85%" r="4" fill="rgba(129, 140, 248, 0.35)" />
        <circle cx="68%" cy="55%" r="5.5" fill="rgba(99, 102, 241, 0.55)" />
        <circle cx="88%" cy="25%" r="3.5" fill="rgba(129, 140, 248, 0.4)" />
        <circle cx="78%" cy="80%" r="4.5" fill="rgba(129, 140, 248, 0.45)" />
      </svg>
      <!-- Subtle Radial Backdrop -->
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_120%,rgba(99,102,241,0.12),transparent_60%)]"></div>
      
      <div class="relative z-10 max-w-3xl">
        <h1 class="text-3xl md:text-4xl font-extrabold text-white tracking-tight">{vaultHome.title}</h1>
        <div class="prose prose-invert max-w-none text-slate-200 mt-4 leading-relaxed text-sm sm:text-base">
          <Fragment set:html={vaultHome.introHtml} />
        </div>
      </div>
    </section>

    <!-- Split Columns Layout below Welcome Hero -->
    <div class="grid lg:grid-cols-3 gap-8">
      
      <!-- Main Content Column (Left 2/3) -->
      <div class="lg:col-span-2 space-y-12">
        
        <!-- Embedded OER Portal Section -->
        <section id="oer-portal" class="space-y-6 border-b border-mathBorder/30 pb-10">
          <!-- Vivid OER Header Hero Card -->
          <div class="py-7 px-6 bg-gradient-to-r from-blue-500 to-indigo-600 rounded-xl text-white shadow-md select-none relative overflow-hidden">
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_90%_80%,rgba(255,255,255,0.15),transparent_40%)]"></div>
            <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight">{oerHome.title}</h2>
            <div class="text-base text-blue-100 mt-2 max-w-xl leading-relaxed">
              <Fragment set:html={oerHome.overviewHtml} />
            </div>
            <div class="mt-5">
              <a href={link('/garden')} class="px-4 py-2 bg-white text-blue-600 font-bold rounded-lg shadow hover:bg-blue-50 transition-colors text-sm no-underline hover:no-underline inline-block">
                🌲 Browse Digital Garden
              </a>
            </div>
          </div>

          <!-- Calculus Course Cards Grid -->
          <div class="grid md:grid-cols-3 gap-5">
            {oerCourses.map(course => (
              <a href={link(`/courses/${course.id}`)} class="group border border-mathBorder rounded-xl p-5 bg-mathBgSecondary/20 hover:bg-mathBgSecondary/60 hover:border-accent hover:shadow transition-all duration-200 no-underline hover:no-underline flex flex-col justify-between h-full">
                <div>
                  <span class="text-3xl block mb-3 select-none">{course.icon}</span>
                  <h3 class="text-base font-bold text-mathTextNormal group-hover:text-accent transition-colors flex items-center gap-1.5 leading-tight">
                    {course.title}
                    {course.code && (
                      <span class="text-[10px] py-0.5 px-1.5 bg-mathBorder rounded font-mono text-mathTextMuted select-none">
                        {course.code}
                      </span>
                    )}
                  </h3>
                  <p class="text-xs text-mathTextMuted mt-2 leading-relaxed line-clamp-4">
                    {course.desc}
                  </p>
                </div>
                <span class="text-[11px] font-bold text-accent group-hover:underline mt-4 block select-none">
                  Explore Syllabus Map ➜
                </span>
              </a>
            ))}
          </div>

          <!-- About this Curriculum box -->
          {oerHome.aboutHtml && (
            <div class="p-5 border border-mathBorder rounded-xl bg-mathBgSecondary/15 leading-relaxed">
              <h4 class="font-bold text-xs text-mathTextNormal uppercase tracking-wider mb-2">About this Curriculum</h4>
              <div class="prose text-xs sm:text-sm text-mathTextMuted max-w-none">
                <Fragment set:html={oerHome.aboutHtml} />
              </div>
            </div>
          )}
        </section>

        <!-- Other Navigation Hubs (Department & Projects, etc.) -->
        {vaultHome.sections.map(section => (
          <section class="space-y-4">
            <h2 class="text-xl font-bold text-mathTextNormal flex items-center gap-2 border-b border-mathBorder/50 pb-2">
              {section.title}
            </h2>
            <div class="grid sm:grid-cols-2 gap-6">
              {section.cards.map(card => (
                <a href={link(card.url)} class="group border border-mathBorder rounded-xl p-5 bg-mathBgSecondary/20 hover:bg-mathBgSecondary/60 hover:border-accent hover:shadow transition-all duration-200 no-underline hover:no-underline flex flex-col justify-between h-full">
                  <div>
                    <h3 class="text-base font-bold text-mathTextNormal group-hover:text-accent transition-colors">
                      {card.title}
                    </h3>
                    {card.description && (
                      <p class="text-xs text-mathTextMuted mt-2 leading-relaxed">
                        {card.description}
                      </p>
                    )}
                  </div>
                  <span class="text-[11px] font-bold text-accent group-hover:underline mt-5 block select-none">
                    Explore Hub ➜
                  </span>
                </a>
              ))}
            </div>
          </section>
        ))}

      </div>

      <!-- Sidebar Column (Right 1/3) -->
      <div class="lg:col-span-1 space-y-6">
        
        <!-- Concept Garden Quick launcher card -->
        <a href={link('/garden')} class="group block border border-mathBorder rounded-xl p-5 bg-mathBgSecondary/20 hover:bg-mathBgSecondary/55 hover:border-accent hover:shadow transition-all duration-200 no-underline hover:no-underline flex flex-col justify-between select-none">
          <div>
            <span class="text-3xl block mb-3">🌲</span>
            <h3 class="text-base font-bold text-mathTextNormal group-hover:text-accent transition-colors leading-snug">
              Zettelkasten Concept Garden
            </h3>
            <p class="text-xs text-mathTextMuted mt-2 leading-relaxed">
              Explore interconnected mathematical definitions, prerequisite nodes, and atomic concept cards bidirectionally.
            </p>
          </div>
          <span class="text-[11px] font-bold text-accent group-hover:underline mt-5 block">
            Enter the Garden ➜
          </span>
        </a>

        <!-- Connect / CTA Widget -->
        <div class="border border-mathBorder rounded-xl bg-mathBgSecondary/15 p-5 space-y-4">
          <h3 class="text-base font-bold text-mathTextNormal flex items-center gap-2 border-b border-mathBorder/50 pb-2 select-none">
            👋 Connect with Me
          </h3>
          <div class="space-y-3 select-none">
            <a href={link('/about')} class="flex items-center gap-3 p-3 rounded-lg border border-mathBorder/40 bg-mathBgSecondary/20 hover:bg-mathBgSecondary/55 hover:border-accent transition-all duration-200 group text-sm font-semibold text-mathTextNormal no-underline hover:no-underline">
              <span class="text-xl">👤</span>
              <div class="flex-1">
                <div class="group-hover:text-accent transition-colors">About Me</div>
                <div class="text-[10px] text-mathTextMuted font-normal mt-0.5">Read my profile & teaching philosophy.</div>
              </div>
              <span class="text-xs text-accent group-hover:translate-x-1 transition-transform">➜</span>
            </a>
            <a href={link('/meet')} class="flex items-center gap-3 p-3 rounded-lg border border-mathBorder/40 bg-mathBgSecondary/20 hover:bg-mathBgSecondary/55 hover:border-accent transition-all duration-200 group text-sm font-semibold text-mathTextNormal no-underline hover:no-underline">
              <span class="text-xl">📅</span>
              <div class="flex-1">
                <div class="group-hover:text-accent transition-colors">Schedule a Meeting</div>
                <div class="text-[10px] text-mathTextMuted font-normal mt-0.5">Book office hours or scheduling details.</div>
              </div>
              <span class="text-xs text-accent group-hover:translate-x-1 transition-transform">➜</span>
            </a>
            <a href={link('/enroll')} class="flex items-center gap-3 p-3 rounded-lg border border-mathBorder/40 bg-mathBgSecondary/20 hover:bg-mathBgSecondary/55 hover:border-accent transition-all duration-200 group text-sm font-semibold text-mathTextNormal no-underline hover:no-underline">
              <span class="text-xl">🎓</span>
              <div class="flex-1">
                <div class="group-hover:text-accent transition-colors">Take a Course</div>
                <div class="text-[10px] text-mathTextMuted font-normal mt-0.5">Find upcoming classes & enrollment links.</div>
              </div>
              <span class="text-xs text-accent group-hover:translate-x-1 transition-transform">➜</span>
            </a>
          </div>
        </div>

        <!-- Recent Blog Posts Feed widget -->
        <div class="border border-mathBorder rounded-xl bg-mathBgSecondary/15 p-5 space-y-4">
          <h3 class="text-base font-bold text-mathTextNormal flex items-center gap-2 border-b border-mathBorder/50 pb-2 select-none">
            📰 Published Articles
          </h3>
          
          {recentNotes.length > 0 ? (
            <div class="space-y-3">
              {recentNotes.map(note => (
                <a href={link(note.url)} class="group block no-underline hover:no-underline">
                  <h4 class="text-xs font-bold text-mathTextNormal group-hover:text-accent transition-colors leading-tight">
                    {note.title}
                  </h4>
                  <p class="text-[9px] text-mathTextMuted font-mono mt-1">
                    Published: {note.updated || '—'}
                  </p>
                </a>
              ))}
            </div>
          ) : (
            <div class="py-6 text-center text-xs text-mathTextMuted italic bg-mathBgSecondary/10 border border-mathBorder/30 rounded-lg select-none">
              No published articles found.
            </div>
          )}
          <div class="pt-2 border-t border-mathBorder/30 select-none">
            <a href={link('/blog')} class="text-[10px] font-bold text-accent hover:underline block">
              View Blog Archive ➜
            </a>
          </div>
        </div>

      </div>

    </div>
  </div>
</BaseLayout>
