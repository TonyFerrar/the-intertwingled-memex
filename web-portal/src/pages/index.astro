---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getVaultHome, getRecentlyUpdatedNotes, getOERPortalHome, getCourseIndex } from '../utils/vaultLoader.js';

const vaultHome = getVaultHome();
const recentNotes = getRecentlyUpdatedNotes();
const oerHome = getOERPortalHome();

// Resolve course indices for embedded OER portal section
const courseIds = ['calc-1', 'calc-2', 'calc-3'];
const oerCourses = courseIds.map(id => {
  const idx = getCourseIndex(id);
  const meta: Record<string, { code: string; icon: string }> = {
    'calc-1': { code: 'MATH-181', icon: '📐' },
    'calc-2': { code: 'MATH-182', icon: '🌀' },
    'calc-3': { code: 'MATH-281', icon: '🕸️' },
  };
  return {
    id,
    title: idx ? idx.title : id.toUpperCase(),
    desc: idx ? idx.description : 'Curriculum details and session mapping.',
    code: meta[id]?.code || '',
    icon: meta[id]?.icon || '📐'
  };
});

const base = import.meta.env.BASE_URL;
const link = (p: string) => `${base.endsWith('/') ? base : base + '/'}${p.startsWith('/') ? p.slice(1) : p}`;

// Type mapping helper for badges
const typeLabels: Record<string, { label: string; badge: string }> = {
  'course-session': { label: 'Session Note', badge: 'bg-accent/10 text-accent border-accent/20' },
  'concept': { label: 'Concept Card', badge: 'bg-amber-500/10 text-amber-500 border-amber-500/20' },
  'blog': { label: 'Blog Post', badge: 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20' }
};
---

<BaseLayout title={vaultHome.title}>
  <div class="space-y-12 max-w-5xl mx-auto">
    <!-- Hero Section with Background image grid pattern -->
    <section class="relative py-12 px-8 overflow-hidden border border-mathBorder/60 rounded-2xl shadow-xl bg-slate-950">
      <!-- Ambient Glows -->
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_70%_120%,rgba(79,70,229,0.18),transparent_50%)]"></div>
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_0%_0%,rgba(15,23,42,0.8),transparent_70%)]"></div>
      <!-- CSS SVG dot pattern -->
      <div class="absolute inset-0 bg-[radial-gradient(rgba(255,255,255,0.06)_1px,transparent_1px)] bg-[size:24px_24px] opacity-75"></div>
      
      <div class="relative z-10 max-w-3xl">
        <h1 class="text-3xl md:text-4xl font-extrabold text-white tracking-tight">{vaultHome.title}</h1>
        <div class="prose prose-invert max-w-none text-slate-200 mt-4 leading-relaxed text-sm sm:text-base">
          <Fragment set:html={vaultHome.introHtml} />
        </div>
      </div>
    </section>

    <!-- Calculus OER Portal Embedded Section (replacing plain Course Directory) -->
    <section id="oer-portal" class="space-y-6">
      <div class="border-b border-mathBorder/50 pb-2">
        <h2 class="text-2xl font-extrabold text-mathTextNormal flex items-center gap-2">
          📚 {oerHome.title}
        </h2>
        <div class="text-sm text-mathTextMuted mt-1 leading-relaxed max-w-2xl">
          <Fragment set:html={oerHome.overviewHtml} />
        </div>
      </div>

      <!-- Course Cards Grid -->
      <div class="grid md:grid-cols-3 gap-6">
        {oerCourses.map(course => (
          <a href={link(`/courses/${course.id}`)} class="group border border-mathBorder rounded-xl p-5 bg-mathBgSecondary/30 hover:bg-mathBgSecondary/70 hover:border-accent hover:shadow transition-all duration-200 no-underline hover:no-underline flex flex-col justify-between h-full">
            <div>
              <span class="text-4xl block mb-4 select-none">{course.icon}</span>
              <h3 class="text-lg font-bold text-mathTextNormal group-hover:text-accent transition-colors flex items-center gap-2">
                {course.title}
                {course.code && (
                  <span class="text-xs py-0.5 px-2 bg-mathBorder rounded font-mono text-mathTextMuted select-none">
                    {course.code}
                  </span>
                )}
              </h3>
              <p class="text-sm text-mathTextMuted mt-2 leading-relaxed">
                {course.desc}
              </p>
            </div>
            <span class="text-xs font-bold text-accent group-hover:underline mt-6 block select-none">
              Explore Syllabus Map ➜
            </span>
          </a>
        ))}
      </div>

      <!-- About this Curriculum box inside OER portal section -->
      {oerHome.aboutHtml && (
        <div class="p-6 border border-mathBorder rounded-xl bg-mathBgSecondary/20 leading-relaxed">
          <h4 class="font-bold text-sm text-mathTextNormal uppercase tracking-wider mb-2">About this Curriculum</h4>
          <div class="prose text-xs sm:text-sm text-mathTextMuted max-w-none">
            <Fragment set:html={oerHome.aboutHtml} />
          </div>
        </div>
      )}
    </section>

    <!-- Other Navigation Hubs (Zettelkasten, Department & Projects) -->
    {vaultHome.sections.map(section => (
      <section class="space-y-4">
        <h2 class="text-xl font-bold text-mathTextNormal flex items-center gap-2 border-b border-mathBorder/50 pb-2">
          {section.title}
        </h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {section.cards.map(card => (
            <a href={link(card.url)} class="group border border-mathBorder rounded-xl p-5 bg-mathBgSecondary/30 hover:bg-mathBgSecondary/70 hover:border-accent hover:shadow transition-all duration-200 no-underline hover:no-underline flex flex-col justify-between h-full">
              <div>
                <h3 class="text-base font-bold text-mathTextNormal group-hover:text-accent transition-colors">
                  {card.title}
                </h3>
                {card.description && (
                  <p class="text-xs text-mathTextMuted mt-2 leading-relaxed">
                    {card.description}
                  </p>
                )}
              </div>
              <span class="text-[11px] font-bold text-accent group-hover:underline mt-4 block select-none">
                Explore Hub ➜
              </span>
            </a>
          ))}
        </div>
      </section>
    ))}

    <!-- Dynamic Published Blog Feed -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-mathTextNormal flex items-center gap-2 border-b border-mathBorder/50 pb-2">
        📰 Published Blog Feed
      </h2>
      <p class="text-xs text-mathTextMuted">
        The table below lists recently published blog notes in this vault.
      </p>

      {recentNotes.length > 0 ? (
        <div class="overflow-x-auto border border-mathBorder rounded-xl bg-mathBgSecondary/20">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="border-b border-mathBorder bg-mathBgSecondary/50 font-semibold text-mathTextNormal text-xs uppercase tracking-wider select-none">
                <th class="p-3 pl-4">Article Title</th>
                <th class="p-3">Type</th>
                <th class="p-3 pr-4 text-right">Published Date</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-mathBorder/40">
              {recentNotes.map(note => {
                const typeInfo = typeLabels[note.type] || { label: note.type, badge: 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20' };
                return (
                  <tr class="hover:bg-mathBgSecondary/40 transition-colors">
                    <td class="p-3 pl-4">
                      <a href={link(note.url)} class="text-accent hover:underline font-semibold block leading-tight">
                        {note.title}
                      </a>
                    </td>
                    <td class="p-3 select-none">
                      <span class={`text-[10px] font-mono font-extrabold px-2 py-0.5 rounded border ${typeInfo.badge}`}>
                        {typeInfo.label}
                      </span>
                    </td>
                    <td class="p-3 pr-4 text-right font-mono text-xs text-mathTextMuted">
                      {note.updated || '—'}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      ) : (
        <div class="py-8 text-center text-sm text-mathTextMuted italic bg-mathBgSecondary/20 border border-mathBorder rounded-xl">
          No published blog posts found.
        </div>
      )}
    </section>
  </div>
</BaseLayout>
