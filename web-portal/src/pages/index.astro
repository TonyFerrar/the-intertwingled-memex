---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getVaultHome, getRecentlyUpdatedNotes } from '../utils/vaultLoader.js';

const vaultHome = getVaultHome();
const recentNotes = getRecentlyUpdatedNotes();

const base = import.meta.env.BASE_URL;
const link = (p: string) => `${base.endsWith('/') ? base : base + '/'}${p.startsWith('/') ? p.slice(1) : p}`;

// Type mapping helper for badges
const typeLabels: Record<string, { label: string; badge: string }> = {
  'course-session': { label: 'Session Note', badge: 'bg-accent/10 text-accent border-accent/20' },
  'concept': { label: 'Concept Card', badge: 'bg-amber-500/10 text-amber-500 border-amber-500/20' },
  'blog': { label: 'Blog Post', badge: 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20' }
};
---

<BaseLayout title={vaultHome.title}>
  <div class="space-y-12 max-w-5xl mx-auto">
    <!-- Hero Section -->
    <section class="py-8 px-6 bg-gradient-to-br from-indigo-950 via-slate-900 to-slate-900 border border-mathBorder/60 rounded-2xl shadow-lg">
      <h1 class="text-3xl md:text-4xl font-extrabold text-white tracking-tight">{vaultHome.title}</h1>
      <div class="prose prose-invert max-w-none text-slate-200 mt-4 leading-relaxed text-sm sm:text-base">
        <Fragment set:html={vaultHome.introHtml} />
      </div>
    </section>

    <!-- Navigation Hubs -->
    {vaultHome.sections.map(section => (
      <section class="space-y-4">
        <h2 class="text-xl font-bold text-mathTextNormal flex items-center gap-2 border-b border-mathBorder/50 pb-2">
          {section.title}
        </h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {section.cards.map(card => (
            <a href={link(card.url)} class="group border border-mathBorder rounded-xl p-5 bg-mathBgSecondary/30 hover:bg-mathBgSecondary/70 hover:border-accent hover:shadow transition-all duration-200 no-underline hover:no-underline flex flex-col justify-between h-full">
              <div>
                <h3 class="text-base font-bold text-mathTextNormal group-hover:text-accent transition-colors">
                  {card.title}
                </h3>
                {card.description && (
                  <p class="text-xs text-mathTextMuted mt-2 leading-relaxed">
                    {card.description}
                  </p>
                )}
              </div>
              <span class="text-[11px] font-bold text-accent group-hover:underline mt-4 block select-none">
                Explore ➜
              </span>
            </a>
          ))}
        </div>
      </section>
    ))}

    <!-- Recently Updated Section -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-mathTextNormal flex items-center gap-2 border-b border-mathBorder/50 pb-2">
        🕒 Recently Updated Notes
      </h2>
      <p class="text-xs text-mathTextMuted">
        The table below lists the most recently updated notes in this vault that are marked for publication.
      </p>

      {recentNotes.length > 0 ? (
        <div class="overflow-x-auto border border-mathBorder rounded-xl bg-mathBgSecondary/20">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="border-b border-mathBorder bg-mathBgSecondary/50 font-semibold text-mathTextNormal text-xs uppercase tracking-wider select-none">
                <th class="p-3 pl-4">Note / Topic</th>
                <th class="p-3">Type</th>
                <th class="p-3">Course</th>
                <th class="p-3 pr-4 text-right">Last Updated</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-mathBorder/40">
              {recentNotes.map(note => {
                const typeInfo = typeLabels[note.type] || { label: note.type, badge: 'bg-gray-500/10 text-gray-400 border-gray-500/20' };
                return (
                  <tr class="hover:bg-mathBgSecondary/40 transition-colors">
                    <td class="p-3 pl-4">
                      <a href={link(note.url)} class="text-accent hover:underline font-semibold block leading-tight">
                        {note.title}
                      </a>
                    </td>
                    <td class="p-3 select-none">
                      <span class={`text-[10px] font-mono font-extrabold px-2 py-0.5 rounded border ${typeInfo.badge}`}>
                        {typeInfo.label}
                      </span>
                    </td>
                    <td class="p-3 font-mono text-xs text-mathTextMuted">
                      {note.course || '—'}
                    </td>
                    <td class="p-3 pr-4 text-right font-mono text-xs text-mathTextMuted">
                      {note.updated || '—'}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      ) : (
        <div class="py-8 text-center text-sm text-mathTextMuted italic bg-mathBgSecondary/20 border border-mathBorder rounded-xl">
          No published notes found.
        </div>
      )}
    </section>
  </div>
</BaseLayout>
