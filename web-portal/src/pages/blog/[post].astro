---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getBlogPosts } from '../../utils/vaultLoader.js';

export function getStaticPaths() {
  const posts = getBlogPosts();
  return posts.map(post => ({
    params: { post: post.slug },
    props: { post }
  }));
}

const { post } = Astro.props;
const allPosts = getBlogPosts();
const otherPosts = allPosts.filter(p => p.slug !== post.slug);

const base = import.meta.env.BASE_URL;
const link = (p: string) => `${base.endsWith('/') ? base : base + '/'}${p.startsWith('/') ? p.slice(1) : p}`;
---

<BaseLayout title={post.title}>
  <div class="max-w-6xl mx-auto">
    <div class="flex flex-col lg:flex-row gap-10">
      <!-- Main Column (Full Reading View of selected post) -->
      <article class="flex-1 lg:max-w-3xl border-b lg:border-b-0 lg:border-r border-mathBorder/50 pb-10 lg:pb-0 lg:pr-10">
        <header class="mb-6 select-none">
          <a href={link('/blog')} class="text-xs font-semibold text-accent hover:underline flex items-center gap-1 mb-4">
            ⬅ Back to latest post
          </a>
          <h1 class="text-3xl sm:text-4xl font-extrabold text-mathTextNormal tracking-tight">
            {post.title}
          </h1>
          <p class="text-xs text-mathTextMuted font-mono mt-2">
            Published on: {post.updated || '—'}
          </p>
        </header>
        
        <div class="prose max-w-none text-mathTextNormal leading-relaxed">
          <Fragment set:html={post.bodyHtml} />
        </div>
      </article>

      <!-- Sidebar / Grid Column (Other Articles List) -->
      <aside class="w-full lg:w-80 shrink-0 space-y-6">
        <h2 class="text-lg font-bold text-mathTextNormal flex items-center gap-2 border-b border-mathBorder/50 pb-2 select-none">
          📖 Archive & Writings
        </h2>
        
        {otherPosts.length > 0 ? (
          <div class="space-y-4">
            {otherPosts.map(p => (
              <a href={link(`/blog/${p.slug}`)} class="group block border border-mathBorder rounded-xl p-4 bg-mathBgSecondary/20 hover:bg-mathBgSecondary/55 hover:border-accent transition-all duration-200 no-underline hover:no-underline flex flex-col justify-between">
                <div>
                  <h3 class="text-sm font-bold text-mathTextNormal group-hover:text-accent transition-colors leading-tight">
                    {p.title}
                  </h3>
                  <p class="text-[10px] text-mathTextMuted font-mono mt-1">
                    {p.updated}
                  </p>
                  <p class="text-xs text-mathTextMuted mt-2 line-clamp-3">
                    {p.description}
                  </p>
                </div>
                <span class="text-[10px] font-bold text-accent group-hover:underline mt-3 block select-none">
                  Read Article ➜
                </span>
              </a>
            ))}
          </div>
        ) : (
          <div class="py-6 text-center text-xs text-mathTextMuted italic bg-mathBgSecondary/10 border border-mathBorder/40 rounded-xl select-none">
            No other articles.
          </div>
        )}
      </aside>
    </div>
  </div>
</BaseLayout>
