---
export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{title} - Print Layout</title>
  <!-- KaTeX CSS CDN -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" crossorigin="anonymous">

  <style is:global>
    :root {
      --background-primary: #ffffff;
      --text-normal: #000000;
      --border-color: #d1d5db;
    }

    body {
      background-color: var(--background-primary);
      color: var(--text-normal);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      font-size: 12pt;
      line-height: 1.5;
    }

    /* Print Specific Styling rules */
    @media print {
      @page {
        size: letter;
        margin: 0.75in;
      }
      
      body {
        margin: 0;
        padding: 0;
      }

      /* Prevent headings from separating from their content */
      h1, h2, h3, h4, h5, h6 {
        page-break-after: avoid;
        break-after: avoid;
      }

      /* Prevent list items or problem blocks from being split in half */
      .print-prevent-split {
        page-break-inside: avoid;
        break-inside: avoid;
      }

      /* Force page breaks after major sections if necessary */
      .print-page-break {
        page-break-after: always;
        break-after: always;
      }
    }

    /* Workspace Styling for PDF Handout */
    .print-workspace {
      border: 1.5px dashed #4b5563;
      background-color: #fafafa;
      height: 180px;
      margin: 1em 0;
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #6b7280;
      font-size: 10pt;
      font-style: italic;
    }
  </style>
</head>
<body class="p-6">
  <slot />
</body>
</html>
